# Judge0 CE API key from RapidAPI (free tier: 50 requests/day)
# Get yours at: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_KEY=your_rapidapi_key_here

# Optional: use a self-hosted Judge0 instance instead of RapidAPI
# JUDGE0_API_URL=https://your-judge0-instance.com

# Optional: which C++ compiler Judge0 should use.
# 54 = C++ (GCC 9.2.0, default), 76 = C++ (Clang 7.0.1),
# 105 = C++ (GCC 14.1.0, newer self-hosted instances only)
# JUDGE0_LANGUAGE_ID=54

# Optional: g++ flags. Defaults to "-O2 -std=c++17". Set empty to send none.
# JUDGE0_COMPILER_OPTIONS=-O2 -std=c++17

# 4-digit PIN to protect the platform (default: 1234)
NEXT_PUBLIC_ACCESS_PIN=1234
